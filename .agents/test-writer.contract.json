{
  "agent_name": "test-writer",
  "input_schema": {
    "required": ["module"],
    "properties": {
      "module": { "type": "string" },
      "scenarios": { "type": "array" }
    }
  },
  "output_schema": {
    "required": ["test_file", "test_names"],
    "properties": {
      "test_file": { "type": "string" },
      "test_names": { "type": "array" },
      "notes": { "type": "string" }
    }
  }
}
