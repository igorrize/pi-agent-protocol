{
  "agent_name": "alpha",
  "input_schema": {
    "required": ["files", "rubric"],
    "properties": {
      "files": { "type": "array" },
      "rubric": { "type": "string" },
      "focus": { "type": "string" }
    }
  },
  "output_schema": {
    "required": ["findings"],
    "properties": {
      "findings": { "type": "array" },
      "summary": { "type": "string" }
    }
  },
  "policy": { "max_test_attempts": 3, "on_exhausted": "ask_user" }
}
